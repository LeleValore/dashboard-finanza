# Copia questo file in .env e inserisci i tuoi valori reali.
# .env è ignorato da git (vedi .gitignore): resta solo su questo Mac,
# viene caricato automaticamente da avvia.sh.

# Opzionale: chiave API Anthropic, abilita il riassunto operativo dei
# Giganti e il sentiment sulle news. Senza chiave (o senza credito residuo)
# lo script salta questi due arricchimenti e mostra comunque il resto del
# report. La ricerca nella knowledge base dei Giganti NON usa questa chiave:
# è puramente locale, lato browser, sempre gratuita.
ANTHROPIC_API_KEY=

# Opzionale: se impostata, il report viene protetto da password (cifratura
# lato client, vedi render_lock_screen in generate_report.py).
SITE_PASSWORD=

# Opzionale: cartella dello storico (days/, knowledge_base/, prices/). Su GitHub
# Actions è il repository privato dei dati; in locale, se non impostata, è la
# cartella del progetto. Meglio un percorso fuori da Desktop e Documenti: iCloud
# può togliere dal disco il contenuto dei file.
DATA_DIR=
